/**
 * A library of commonly used mathematical functions.
 * Note: Jack compilers implement multiplication and division using OS method calls.
 */
class Math {
	static Array pow2;
	static boolean sign;

    /** Initializes the library. */
    function void init() {
		var int i;
		var int j;
		let i = 0;
		let j = 1;
		let pow2 = Array.new(15);
		
		while(i<16) {
			let pow2[i] = j;
			let j = j + j;
			let i = i + 1;
		}
	return;
    }

    /** Returns the absolute value of x. */
    function int abs(int x) {
		if(x < 0) {
			let x = -x;
			}	
    return x;
    }

    /** Returns the product of x and y. 
     *  When a Jack compiler detects the multiplication operator '*' in the 
     *  program's code, it handles it by invoking this method. In other words,
     *  the Jack expressions x*y and multiply(x,y) return the same value.
     */
    function int multiply(int x, int y) {
		var int sum;
		var int shiftedx;
		var int secondfactor;
		var int i;
		
		let sum = 0;
		let shiftedx = x;
		let secondfactor = y;
		let i = 0;
		
		while (i < 16) {
			if (Math.bit(secondfactor, i)) {
				let sum = sum + shiftedx;
				}
			let shiftedx = shiftedx + shiftedx;
			let i = i + 1;
		}
		
    return sum;
    }

    /** Returns the integer part of x/y.
     *  When a Jack compiler detects the multiplication operator '/' in the 
     *  program's code, it handles it by invoking this method. In other words,
     *  the Jack expressions x/y and divide(x,y) return the same value.
     */
    function int divide(int x, int y) {
        var int q;
        let q = Math._divide(Math.abs(x), Math.abs(y)); 
        if ((x < 0) = (y < 0)) {						 // if signs differ the returning value must be negative
            return q;
        } else {
            return -q;
        }
    }

    function int _divide(int x, int y) {
        var int q;
        if ((y > x) | (y < 0)) {						 // y<0 means that y overflowed during the compution of y+y. In this case 0 must be returned.
            return 0;
        }
        let q = Math._divide(x, y+y);
        if ((x - (2*q*y)) < y) {
            return q+q;
        } else {
            return q+q+1;
        }
    } 
    
    
    /** Returns the integer part of the square root of x. */
    function int sqrt(int x) {
		var int y;
		var int j;
		var int test;
		let y = 0;
		let j = 7;
		
		while(j > -1) {
			/*do Output.printInt(y);
			do Output.printChar(32);
			do Output.printInt(Math.pow(y + Math.pow(2, j), 2));
			do Output.println(); */
			if((Math.pow(y + Math.pow(2, j), 2) < x) | (Math.pow(y + Math.pow(2, j), 2) = x)){
				let y = y + Math.pow(2, j);
				}
			let j = j - 1;
			}
		do Output.printInt(y);
		do Output.println();
    return y;
    }
    
    function int pow(int base, int exp) {
		var int i;
		var int result;
		let i = 1;
		let result = base;
		
		if(exp = 0) {
			return 1;
			}
		
		while(i < exp) {
			let result = Math.multiply(result, base);
			let i = i + 1;
		}
		return result;
    }

    /** Returns the greater number. */
    function int max(int a, int b) { 
		if(a>b) {
			return a;
			}
		else {
			return b;
			}
    }

    /** Returns the smaller number. */
    function int min(int a, int b) {		
		if (a<b) {
			return a;
			}
		else {
			return b;
			}
    }
    
    function boolean bit(int x, int i) {
		if(x & pow2[i] = 0) {
			return false;
			}
		else {
			return true;
			}
	}
}
